# HTTP rules. They match the parsed, normalized request (sticky buffers),
# not the raw stream, so URL encoding, %u, overlong UTF-8, "/./", "//",
# ".." and absolute-form URIs cannot hide the content. Port "any": HTTP
# is recognized by content on every port.
#
#   http.uri           decoded + path-normalized request target
#   http.uri.raw       request target exactly as sent
#   http.header        all headers as "Name: value\r\n" lines
#   http.user_agent    the User-Agent value
#   http.request_body  de-chunked body (URL-decoded for form posts)

# XSS Attack
alert http any any -> any any (msg:"XSS: Script tag detected"; http.uri; content:"<script>"; nocase; sid:1001; priority:1;)
alert http any any -> any any (msg:"XSS: JavaScript protocol"; http.uri; content:"javascript:"; nocase; sid:1002; priority:1;)
alert http any any -> any any (msg:"XSS: Event handler"; http.uri; content:"onerror="; nocase; sid:1003; priority:3;)
alert http any any -> any any (msg:"XSS: Script tag in request body"; http.request_body; content:"<script>"; nocase; sid:1011; priority:1;)
alert http any any -> any any (msg:"XSS: Script tag in a header"; http.header; content:"<script>"; nocase; sid:1012; priority:1;)

# SQL Injection
alert http any any -> any any (msg:"SQL Injection: Classic OR bypass"; http.uri; content:"' OR 1=1"; nocase; sid:2001; priority:1;)
alert http any any -> any any (msg:"SQL Injection: UNION attack"; http.uri; content:"UNION SELECT"; nocase; sid:2002; priority:1;)
alert http any any -> any any (msg:"SQL Injection: DROP TABLE command"; http.uri; content:"DROP TABLE"; nocase; sid:2003; priority:1;)
alert http any any -> any any (msg:"SQL Injection: Code execution"; http.uri; content:"exec("; nocase; sid:2004; priority:1;)
alert http any any -> any any (msg:"SQL Injection: OR bypass in request body"; http.request_body; content:"' OR 1=1"; nocase; sid:2011; priority:1;)
alert http any any -> any any (msg:"SQL Injection: UNION attack in request body"; http.request_body; content:"UNION SELECT"; nocase; sid:2012; priority:1;)

# Command Injection
alert http any any -> any any (msg:"Command Injection: Windows CMD"; http.uri; content:"cmd.exe"; nocase; sid:3001; priority:1;)
alert http any any -> any any (msg:"Command Injection: Unix Shell"; http.uri; content:"/bin/sh"; sid:3002; priority:1;)
alert http any any -> any any (msg:"Command Injection: Shell variable"; http.uri; content:"$("; sid:3003; priority:2;)
alert http any any -> any any (msg:"Command Injection: Dangerous command"; http.uri; content:"; rm -rf"; nocase; sid:3004; priority:1;)
alert http any any -> any any (msg:"Command Injection: Unix Shell in request body"; http.request_body; content:"/bin/sh"; sid:3011; priority:1;)

# Path Traversal. ".." in the path is resolved by normalization (a climb
# above the root raises anomaly 900010); 4001/4002 catch it in the query.
alert http any any -> any any (msg:"Path Traversal: Directory climbing"; http.uri; content:"../"; sid:4001; priority:2;)
alert http any any -> any any (msg:"Path Traversal: Windows style"; http.uri; content:"..\\"; sid:4002; priority:2;)
alert http any any -> any any (msg:"Path Traversal: Unix passwd file access"; http.uri; content:"/etc/passwd"; sid:4003; priority:1;)
alert http any any -> any any (msg:"Path Traversal: Windows System32 access"; http.uri; content:"C:\\Windows\\System32"; nocase; sid:4004; priority:1;)
alert http any any -> any any (msg:"Path Traversal: Windows System32 access (normalized path)"; http.uri; content:"/Windows/System32/"; nocase; sid:4005; priority:1;)

# Scanner/Tool Detection
alert http any any -> any any (msg:"Attack Tool: SQLMap detected"; http.user_agent; content:"sqlmap"; nocase; sid:5001; priority:1;)
alert http any any -> any any (msg:"Attack Tool: Nikto scanner"; http.user_agent; content:"nikto"; nocase; sid:5002; priority:1;)
alert http any any -> any any (msg:"Attack Tool: Nmap scanner"; http.user_agent; content:"nmap"; nocase; sid:5003; priority:2;)
alert http any any -> any any (msg:"Attack Tool: Acunetix scanner"; http.user_agent; content:"acunetix"; nocase; sid:5004; priority:1;)

# File Upload Attacks
alert http any any -> any any (msg:"Suspicious File Upload: PHP file"; http.header; content:"Content-Type: application/x-php"; nocase; sid:6001; priority:2;)
alert http any any -> any any (msg:"PHP file in request"; http.uri; content:".php"; nocase; sid:6002; priority:3;)
